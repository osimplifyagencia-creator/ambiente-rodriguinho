# Chaves do ambiente. Como usar:
#   1. Copie este arquivo para um novo arquivo chamado .env (o scripts\instalar.ps1 faz isso).
#   2. Preencha só o que for usar; o resto pode ficar em branco.
#   3. O .env nunca vai para o GitHub e nunca se cola no chat. Se uma chave vazar, gere outra.
# Não ponha aspas nem espaço em volta do sinal de igual.
# A skill meta-app-e-acessos conduz o passo a passo das chaves da Meta.

# --- Meta (Facebook e Instagram) ---

# Token de acesso da Meta. Onde pegar: Meta Business Suite, Configurações, Usuários, Usuários do sistema,
# criar um usuário do sistema, dar acesso à conta de anúncios e à página, Gerar token (a skill meta-app-e-acessos guia).
META_ACCESS_TOKEN=

# Número da conta de anúncios. Onde pegar: Gerenciador de Anúncios, no seletor de contas no alto da tela (formato act_123456789).
META_AD_ACCOUNT_ID=

# Número da página do Facebook da empresa. Onde pegar: a página no Facebook, Sobre, Transparência da página (ID da página).
META_PAGE_ID=

# Número do pixel (mede o que acontece depois do clique). Onde pegar: Gerenciador de Eventos, Fontes de dados, o pixel, ID.
META_PIXEL_ID=

# Número do app da Meta. Onde pegar: developers.facebook.com, Meus apps, o app, Configurações, Básico, ID do app.
META_APP_ID=

# --- Google ---

# Número da conta do Google Ads, 10 dígitos, sem traços. Onde pegar: ads.google.com, no alto da tela, ao lado do nome da conta.
GOOGLE_ADS_CUSTOMER_ID=

# Token de desenvolvedor do Google Ads. Onde pegar: ads.google.com, conta de administrador, Ferramentas, Acesso e segurança da API (Central de API).
GOOGLE_ADS_DEVELOPER_TOKEN=

# Chave do Gemini, que gera as imagens dos criativos (agente iris). Onde pegar: aistudio.google.com, Get API key.
GEMINI_API_KEY=

# --- Opcional ---

# Qual Chrome o Claude usa. Onde pegar: rode "bsk browsers" no PowerShell e copie o código da coluna INSTANCE
# (ou o nome que você deu ao navegador no ícone da extensão). Só precisa se houver mais de um Chrome conectado.
BSK_NAVEGADOR=
